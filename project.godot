; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bullet Speel"
run/main_scene="res://scenes/levels/main_menu.tscn"
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/ui/bullet_loading.png"
config/icon="res://sprites/ui/exec-icon.webp"

[audio]

buses/default_bus_layout="res://assets/default_bus_layout.tres"

[autoload]

Global="*res://scripts/global.gd"

[display]

window/size/resizable=false
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Bulletspeel"

[global_group]

Bullets=""
levelMenu=""
Player=""
Timers=""

